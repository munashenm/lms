# SchoolHub SA environment template
# Copy to .env — never commit secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolhub"
# Production: the app adds sslmode=require for non-local hosts if it is missing.
JWT_SECRET="change-me-in-development-use-a-long-random-value-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="change-me"

# Licensing (LMS verifies with the public key only)
LICENSE_PUBLIC_KEY=""
LICENSE_SERVER_URL=""
LICENSE_HEARTBEAT_HOURS="24"
LICENSE_OFFLINE_GRACE_DAYS="14"
# Production must leave this false/unset so only signed licences are trusted after activation
LICENSE_TRUST_LOCAL="false"

# Vendor licence server (do not set on customer installs)
LICENSE_SERVER_ENABLED="false"
LICENSE_SIGNING_PRIVATE_KEY=""

# Backup
BACKUP_ENCRYPTION_KEY="change-me-to-a-long-random-passphrase"
BACKUP_STORAGE_PROVIDER="local"
BACKUP_LOCAL_PATH="./data/backups"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# Paystack (optional; prefer school Settings → Integrations)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# SMS generic REST fallback (optional; prefer school Settings)
SMS_PROVIDER="TWILIO"
SMS_REST_URL=""
SMS_REST_API_KEY=""
SMS_REST_FROM=""
SMS_REST_BODY_TEMPLATE=""
SMS_REST_AUTH_HEADER=""
SMS_REST_METHOD="POST"
IMPORT_ENCRYPTION_KEY=""
IMPORT_TEMP_DIR="./data/imports"
IMPORT_MAX_FILE_BYTES="52428800"
IMPORT_FILE_TTL_HOURS="24"
