  ID_PASSPORT
  PAST_RESULTS
  OTHER
}

enum StudentAidType {
  DISCOUNT
  BURSARY
  SCHOLARSHIP
  SPONSORSHIP
}

enum RecurringInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SalaryPayType {
  MONTHLY
  HOURLY
}

enum VisitorIdentityType {
  SA_ID
  PASSPORT
  DRIVERS_LICENCE
  OTHER
}

enum VisitorHostKind {
  STAFF
  LEARNER
  OTHER
}

enum VisitorPurpose {
  PARENT_GUARDIAN
  ENROLMENT
  DELIVERY
  CONTRACTOR
  OFFICIAL
  SPORTS_CULTURE
  MEETING
  OTHER
}

// ─── Multi-tenant Core ───────────────────────────────────────────────────────

model School {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  institutionType InstitutionType @default(SCHOOL)
  curriculumType  CurriculumType  @default(CAPS)
  periodStructure AcademicPeriodStructure @default(TERMS_4)
  registrationNo  String?
  email           String?
  phone           String?
  website         String?
  logoUrl         String?
  primaryColor    String?
  accentColor     String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  timezone        String          @default("Africa/Johannesburg")
  currency        String          @default("ZAR")
  popiaConsentText String?
  absenceNotifyEnabled Boolean    @default(false)
  teacherReviewsAnonymous Boolean @default(true)
  studentLeaveRequiresGuardian Boolean @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  campuses        Campus[]
  users           User[]
  academicYears   AcademicYear[]
  grades          Grade[]
  subjects        Subject[]
  courses         Course[]
  classes         Class[]
  students        Student[]
  teachers        Teacher[]
  guardians       Guardian[]
  applications    Application[]
  announcements   Announcement[]
  auditLogs       AuditLog[]
  documents       Document[]
  invoices        Invoice[]
  feeScheduleItems FeeScheduleItem[]
  feeReminderRules FeeReminderRule[]
  feeReminderDispatches FeeReminderDispatch[]
  notifications   Notification[]
  certificates    Certificate[]
  leaveRequests   LeaveRequest[]
  ledgerEntries   LedgerEntry[]
  studentLedgerEntries StudentLedgerEntry[]
  communicationLogs CommunicationLog[]
  communicationBatches CommunicationBatch[]
  staffAttendance StaffAttendanceRecord[]
  integrationConfig SchoolIntegrationConfig?
  license              SchoolLicense?
  licenseInstallation  LicenseInstallation?
  licenseChecks        LicenseCheck[]
  backupJobs           BackupJob[]
  backupSchedules      BackupSchedule[]
  restoreJobs          RestoreJob[]
  importJobs           ImportJob[]
  importBatches        ImportBatch[]
  importFieldMappings  ImportFieldMapping[]
  externalRecordMappings ExternalRecordMapping[]
  integrationProviders IntegrationProvider[]
  feeStructures          FeeStructure[]
  studentCharges         StudentCharge[]
  paymentAllocations     PaymentAllocation[]
  suppliers              Supplier[]
  expenseCategories      ExpenseCategory[]
  incomeCategories       IncomeCategory[]
  financialAccounts      FinancialAccount[]
  expenses               Expense[]
  recurringExpenses      RecurringExpense[]
  otherIncomes           OtherIncome[]
  creditNotes            CreditNote[]
  refunds                Refund[]
  studentAidAwards       StudentAidAward[]
  employees              Employee[]
  leavePolicies          LeavePolicy[]
  payrollRuleSets        PayrollRuleSet[]
  payrollRuns            PayrollRun[]
  studentAbsenceRequests StudentAbsenceRequest[]
  teacherReviews         TeacherReview[]
  lessonPlans            LessonPlan[]
  curriculumTopics       CurriculumTopic[]
  visitorEntries         VisitorEntry[]

  @@index([slug])
  @@map("schools")
}

model Campus {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  code       String
  address    String?
  city       String?
  province   String?
  postalCode String?
  phone      String?
  isMain     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students   Student[]
  classes    Class[]
  teachers   Teacher[]
  employees  Employee[]
  feeStructures FeeStructure[]
  financialAccounts FinancialAccount[]
  visitorEntries VisitorEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("campuses")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  schoolId     String?
  email        String    @unique
  passwordHash String
  passwordResetTokenHash String?
  passwordResetExpires   DateTime?
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         UserRole
  isActive     Boolean   @default(true)
  emailVerified Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?
  teacher      Teacher?
  guardian     Guardian?
  auditLogs    AuditLog[] @relation("AuditActor")
  announcements Announcement[] @relation("AnnouncementAuthor")
  documents    Document[] @relation("DocumentUploader")
  notifications Notification[]
  certificatesIssued Certificate[] @relation("CertificateIssuer")
  leaveReviews       LeaveRequest[] @relation("LeaveReviewer")
  leaveApplications  LeaveRequest[] @relation("LeaveApplicant")
  studentAbsenceReviews StudentAbsenceRequest[] @relation("StudentAbsenceReviewer")
  ledgerEntries      LedgerEntry[]  @relation("LedgerRecorder")
  studentLedgerEntries StudentLedgerEntry[] @relation("StudentLedgerRecorder")
  staffAttendance    StaffAttendanceRecord[] @relation("StaffAttendanceUser")
  staffAttendanceMarked StaffAttendanceRecord[] @relation("StaffAttendanceMarker")
  backupJobsCreated  BackupJob[] @relation("BackupCreator")
  restoreJobsCreated RestoreJob[] @relation("RestoreCreator")
  importJobsCreated  ImportJob[] @relation("ImportCreator")
  employee           Employee?
  visitorsSignedIn   VisitorEntry[] @relation("VisitorSignedInBy")
  visitorsSignedOut  VisitorEntry[] @relation("VisitorSignedOutBy")

  @@index([schoolId])
  @@index([role])
  @@map("users")
}

// ─── Academic Structure ──────────────────────────────────────────────────────

model AcademicYear {
  id        String                @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicSessionStatus @default(PLANNED)
  isCurrent Boolean               @default(false)
  closedAt  DateTime?
  archivedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     Term[]
  classes   Class[]
  enrolments Enrolment[]
  reportCards ReportCard[]
  certificates Certificate[]
  studentLedgerEntries StudentLedgerEntry[]
  feeStructures        FeeStructure[]
  studentCharges       StudentCharge[]
  payrollRuns          PayrollRun[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Term {
  id                    String                @id @default(cuid())
  academicYearId        String
  name                  String
  termNumber            Int
  startDate             DateTime
  endDate               DateTime
  status                AcademicPeriodStatus  @default(PLANNED)
  isCurrent             Boolean               @default(false)
  resultsPublishingDate DateTime?
  attendanceStartDate   DateTime?
  attendanceEndDate     DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assessments    Assessment[]
  reportCards    ReportCard[]
  attendanceRecords AttendanceRecord[]
  feeStructures  FeeStructure[]
  lessonPlans    LessonPlan[]
  curriculumTopics CurriculumTopic[]

  @@unique([academicYearId, termNumber])
  @@index([academicYearId])
  @@index([academicYearId, isCurrent])
  @@map("terms")
}

model Grade {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  level     Int?
  phase     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]
  classes   Class[]
  subjects  Subject[]
  enrolments Enrolment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("grades")
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  gradeId     String?
  code        String
  name        String
  description String?
  credits     Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       Grade?   @relation(fields: [gradeId], references: [id])
  classSubjects ClassSubject[]
  assessments Assessment[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  lessonPlans       LessonPlan[]
  curriculumTopics  CurriculumTopic[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model Course {
  id          String   @id @default(cuid())
  schoolId    String
  code        String
  name        String
  description String?
  nqfLevel    Int?
  durationMonths Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  modules     Module[]
  enrolments  Enrolment[]
  certificates Certificate[]
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  code        String
  name        String
  description String?
  credits     Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  feeStructures     FeeStructure[]
  enrolmentModules  EnrolmentModule[]

  @@unique([courseId, code])
  @@index([courseId])
  @@map("modules")
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  campusId       String?
  gradeId        String?
  academicYearId String?
  name           String
  capacity       Int?
  room           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id])
  grade          Grade?       @relation(fields: [gradeId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  students       Student[]
  classTeachers  ClassTeacher[]
  classSubjects  ClassSubject[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  enrolments     Enrolment[]
  feeStructures  FeeStructure[]
  lessonPlans    LessonPlan[]
  curriculumTopics CurriculumTopic[]

  @@index([schoolId])
  @@map("classes")
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@map("class_teachers")
}

// ─── People ──────────────────────────────────────────────────────────────────

model Student {
  id              String        @id @default(cuid())
  schoolId        String
  userId          String?       @unique
  campusId        String?
  gradeId         String?
  classId         String?
  studentNumber   String
  saIdNumber      String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  email           String?
  phone           String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  photoUrl        String?
  status          StudentStatus @default(ACTIVE)
  popiaConsentAt  DateTime?
  enrolledAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])
  campus          Campus?       @relation(fields: [campusId], references: [id])
  grade           Grade?        @relation(fields: [gradeId], references: [id])
  class           Class?        @relation(fields: [classId], references: [id])
  guardians       StudentGuardian[]
  enrolments      Enrolment[]
  attendanceRecords AttendanceRecord[]
  marks           Mark[]
  reportCards     ReportCard[]
  invoices        Invoice[]
  submissions     AssignmentSubmission[]
  applications    Application[]
  certificates    Certificate[]
  ledgerEntries   StudentLedgerEntry[]
  communicationLogs CommunicationLog[]
  charges         StudentCharge[]
  creditNotes     CreditNote[]
  refunds         Refund[]
  aidAwards       StudentAidAward[]
  absenceRequests StudentAbsenceRequest[]
  teacherReviews  TeacherReview[]
  documents       StudentDocument[]

  @@unique([schoolId, studentNumber])
  @@index([schoolId])
  @@index([status])
  @@map("students")
}

model StudentDocument {
  id         String              @id @default(cuid())
  studentId  String
  type       StudentDocumentType @default(OTHER)
  title      String
  fileUrl    String
  mimeType   String?
  fileSize   Int?
  createdAt  DateTime            @default(now())

  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
  @@map("student_documents")
}

model Teacher {
  id            String      @id @default(cuid())
  schoolId      String
  userId        String?     @unique
  campusId      String?
  employeeNumber String
  saIdNumber    String?
  firstName     String
  lastName      String
  email         String?
  phone         String?
  qualification String?
  department    String?
  status        StaffStatus @default(ACTIVE)
  hiredAt       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])
  campus        Campus?     @relation(fields: [campusId], references: [id])
  classTeachers ClassTeacher[]
  classSubjects ClassSubject[]
  assessments   Assessment[] @relation("AssessmentCreator")
  timetableSlots TimetableSlot[]
  leaveRequests  LeaveRequest[]
  employee       Employee?
  lessonPlans    LessonPlan[]
  teacherReviews TeacherReview[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId])
  @@map("teachers")
}

model Guardian {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String?  @unique
  firstName    String
  lastName     String
  email        String?
  phone        String?
  saIdNumber   String?
  relationship String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])
  students     StudentGuardian[]

  @@index([schoolId])
  @@map("guardians")
}

model StudentGuardian {
  id           String   @id @default(cuid())
  studentId    String
  guardianId   String
  relationship String
  isPrimary    Boolean  @default(false)
  canPickup    Boolean  @default(true)
  createdAt    DateTime @default(now())

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

// ─── Enrolments & Admissions ─────────────────────────────────────────────────

model Enrolment {
  id             String          @id @default(cuid())
  studentId      String
  courseId       String?
  academicYearId String
  gradeId        String?
  classId        String?
  status         EnrolmentStatus @default(ENROLLED)
  hostel         Boolean         @default(false)
  transport      Boolean         @default(false)
  enrolledAt     DateTime        @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course?      @relation(fields: [courseId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade          Grade?       @relation(fields: [gradeId], references: [id])
  class          Class?       @relation(fields: [classId], references: [id])
  modules        EnrolmentModule[]
  charges        StudentCharge[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([studentId, academicYearId])
  @@index([gradeId])
  @@index([classId])
  @@map("enrolments")
}

model Application {
  id              String            @id @default(cuid())
  schoolId        String
  studentId       String?
  referenceNo     String
  firstName       String
  lastName        String
  saIdNumber      String?
  email           String?
  phone           String?
  gradeApplied    String?
  courseApplied   String?
  guardianFirstName    String?
  guardianLastName     String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?
  status          ApplicationStatus @default(SUBMITTED)
  notes           String?
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student? @relation(fields: [studentId], references: [id])

  @@unique([schoolId, referenceNo])
  @@index([schoolId, status])
  @@map("applications")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

model AttendanceRecord {
  id           String           @id @default(cuid())
  studentId    String
  classId      String?
  subjectId    String?
  moduleId     String?
  termId       String?
  date         DateTime         @db.Date
  sessionKey   String           @default("daily")
  sessionStart String?
  sessionEnd   String?
  status       AttendanceStatus
  notes        String?
  markedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class?   @relation(fields: [classId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  module    Module?  @relation(fields: [moduleId], references: [id])
  term      Term?    @relation(fields: [termId], references: [id])

  @@unique([studentId, date, sessionKey])
  @@index([studentId, date])
  @@index([classId, date])
  @@index([moduleId, date])
  @@index([termId, date])
  @@map("attendance_records")
}

// ─── Timetable ───────────────────────────────────────────────────────────────

model TimetableSlot {
  id        String    @id @default(cuid())
  classId   String
  subjectId String?
  moduleId  String?
  teacherId String?
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String?
  onlineMeetingUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id])
  module    Module?  @relation(fields: [moduleId], references: [id])
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([classId])
  @@map("timetable_slots")
}

// ─── Assessments & Marks ─────────────────────────────────────────────────────

model Assessment {
  id          String         @id @default(cuid())
  subjectId   String?
  moduleId    String?
  termId      String?
  teacherId   String?
  title       String
  description String?
  type        AssessmentType
  maxMarks    Decimal        @db.Decimal(6, 2)
  weight      Decimal?       @db.Decimal(5, 2)
  dueDate     DateTime?
  venue       String?
  durationMinutes Int?
  availableFrom DateTime?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject     Subject?  @relation(fields: [subjectId], references: [id])
  module      Module?   @relation(fields: [moduleId], references: [id])
  term        Term?     @relation(fields: [termId], references: [id])
  teacher     Teacher?  @relation("AssessmentCreator", fields: [teacherId], references: [id])
  marks       Mark[]
  assignment  Assignment?

  @@index([subjectId])
  @@index([moduleId])
  @@map("assessments")
}

model Assignment {
  id             String   @id @default(cuid())
  assessmentId   String   @unique
  instructions   String?
  allowLate      Boolean  @default(false)
  maxSubmissions Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  submittedAt  DateTime @default(now())
  grade        Decimal? @db.Decimal(6, 2)
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Mark {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Decimal  @db.Decimal(6, 2)
  gradeSymbol  String?
  comments     String?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("marks")
}

model ReportCard {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  termId         String?
  overallAverage Decimal? @db.Decimal(5, 2)
  comments       String?
  pdfUrl         String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?        @relation(fields: [termId], references: [id])

  @@index([studentId])
  @@map("report_cards")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  schoolId      String
  studentId     String
  invoiceNumber String
  description   String?
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]
  payments      Payment[]
  ledgerEntries StudentLedgerEntry[]
  reminderDispatches FeeReminderDispatch[]
  charges       StudentCharge[]
  allocations   PaymentAllocation[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model Payment {
  id            String        @id @default(cuid())
  schoolId      String
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  receiptNumber String
  reversedAt    DateTime?
  reversalOfId  String?
  recordedById  String?
  gatewayProvider String?

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ledgerEntries StudentLedgerEntry[]
  allocations   PaymentAllocation[]
  reversalOf    Payment?      @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversals     Payment[]     @relation("PaymentReversal")

  @@unique([schoolId, receiptNumber])
  @@index([invoiceId])
  @@index([schoolId, paidAt])
  @@map("payments")
}

model FeeScheduleItem {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive, sortOrder])
  @@map("fee_schedule_items")
}

/// Automated fee reminder rule. daysOffset: negative = before due, 0 = due date, positive = days overdue.
model FeeReminderRule {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  daysOffset    Int
  /// EMAIL | SMS | BOTH
  channel       String   @default("EMAIL")
  isEnabled     Boolean  @default(true)
  emailTemplate String?
  smsTemplate   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dispatches    FeeReminderDispatch[]

  @@unique([schoolId, daysOffset, channel])
  @@index([schoolId, isEnabled])
  @@map("fee_reminder_rules")
}

model FeeReminderDispatch {
  id                  String   @id @default(cuid())
  schoolId            String
  ruleId              String
  invoiceId           String
  studentId           String
  channel             String
  communicationLogId  String?
  dispatchedAt        DateTime @default(now())

  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rule                FeeReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  invoice             Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([ruleId, invoiceId, channel])
  @@index([schoolId, dispatchedAt])
  @@index([studentId])
  @@map("fee_reminder_dispatches")
}

// ─── Documents & Communications ──────────────────────────────────────────────

model Document {
  id          String       @id @default(cuid())
  schoolId    String
  uploadedBy  String?
  title       String
  description String?
  type        DocumentType
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  isPublic    Boolean      @default(false)
  learnerVisible Boolean   @default(false)
  targetGradeId String?
  targetClassId String?
  targetCampusId String?
  targetCourseId String?
  targetStudentId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader    User?        @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([schoolId, type])
  @@map("documents")
}

model Announcement {
  id        String               @id @default(cuid())
  schoolId  String
  authorId  String?
  title     String
  content   String
  audience  AnnouncementAudience @default(ALL)
  isPinned  Boolean              @default(false)
  publishAt DateTime             @default(now())
  expiresAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author    User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([schoolId, publishAt])
  @@map("announcements")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  schoolId  String?
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([schoolId])
  @@map("notifications")
}

// ─── Certificates ────────────────────────────────────────────────────────────

model Certificate {
  id             String          @id @default(cuid())
  schoolId       String
  studentId      String
  courseId       String?
  academicYearId String?
  certificateNo  String
  type           CertificateType @default(COMPLETION)
  title          String
  description    String?
  issuedAt       DateTime        @default(now())
  pdfUrl         String?
  issuedById     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course?         @relation(fields: [courseId], references: [id])
  academicYear   AcademicYear?   @relation(fields: [academicYearId], references: [id])
  issuedBy       User?           @relation("CertificateIssuer", fields: [issuedById], references: [id])

  @@unique([schoolId, certificateNo])
  @@index([studentId])
  @@map("certificates")
}

// ─── HR & Leave ──────────────────────────────────────────────────────────────

model LeaveRequest {
  id               String      @id @default(cuid())
  schoolId         String
  userId           String
  teacherId        String?
  type             LeaveType
  status           LeaveStatus @default(PENDING)
  startDate        DateTime
  endDate          DateTime
  days             Decimal     @db.Decimal(4, 1)
  reason           String
  notes            String?
  sickNoteUrl      String?
  sickNoteFilename String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  employeeId       String?
  leavePolicyId    String?

  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicant        User        @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  teacher          Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  reviewedBy       User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  employee         Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  leavePolicy      LeavePolicy? @relation(fields: [leavePolicyId], references: [id])

  @@index([schoolId, status])
  @@index([teacherId])
  @@index([userId])
  @@map("leave_requests")
}

// ─── Staff Attendance ────────────────────────────────────────────────────────

model StaffAttendanceRecord {
  id         String                @id @default(cuid())
  schoolId   String
  userId     String
  date       DateTime              @db.Date
  status     StaffAttendanceStatus @default(PRESENT)
  checkIn    String?
  checkOut   String?
  notes      String?
  markedById String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  employeeId String?
  source     String                @default("MANUAL")
  overtimeMinutes Int              @default(0)

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User   @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  markedBy   User?  @relation("StaffAttendanceMarker", fields: [markedById], references: [id])
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([schoolId, date])
  @@map("staff_attendance_records")
}

// ─── School Integrations (email, SMS, payments) ─────────────────────────────

model SchoolIntegrationConfig {
  id        String   @id @default(cuid())
  schoolId  String   @unique

  sendgridEnabled   Boolean @default(false)
  sendgridApiKey    String?
  sendgridFromEmail String?
  sendgridFromName  String?

  twilioEnabled      Boolean @default(false)
  twilioAccountSid   String?
  twilioAuthToken    String?
  twilioFromNumber   String?

  payfastEnabled     Boolean @default(false)
  payfastMerchantId  String?
  payfastMerchantKey String?
  payfastPassphrase  String?
  payfastSandbox     Boolean @default(true)

  ozowEnabled    Boolean @default(false)
  ozowSiteCode   String?
  ozowPrivateKey String?
  ozowSandbox    Boolean @default(true)

  yocoEnabled       Boolean @default(false)
  yocoSecretKey     String?
  yocoWebhookSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_integration_configs")
}

// ─── General Ledger (Income & Expenses) ──────────────────────────────────────

model LedgerEntry {
  id           String          @id @default(cuid())
  schoolId     String
  type         LedgerEntryType
  category     String
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  reference    String?
  entryDate    DateTime
  recordedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vatAmount    Decimal         @default(0) @db.Decimal(12, 2)
  supplierId   String?
  financialAccountId String?
  payrollRunId String?
  expenseId    String?         @unique
  otherIncomeId String?        @unique
  approvalStatus ApprovalStatus @default(POSTED)
  attachmentUrl String?

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy   User?           @relation("LedgerRecorder", fields: [recordedById], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  payrollRun   PayrollRun?     @relation(fields: [payrollRunId], references: [id])
  expense      Expense?        @relation(fields: [expenseId], references: [id])
  otherIncome  OtherIncome?    @relation(fields: [otherIncomeId], references: [id])

  @@index([schoolId, type])
  @@index([schoolId, entryDate])
  @@map("ledger_entries")
}

// ─── Student Financial Ledger & Communications ───────────────────────────────

model StudentLedgerEntry {
  id             String            @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String?
  type           StudentLedgerType
  description    String
  /// Positive increases amount owed; negative reduces it (payments/credits)
  signedAmount   Decimal           @db.Decimal(12, 2)
  reference      String?
  invoiceId      String?
  paymentId      String?
  entryDate      DateTime          @default(now())
  recordedById   String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  chargeSource   FeeChargeSource?
  studentChargeId String?
  reversesEntryId String?

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id])
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id])
  payment        Payment?          @relation(fields: [paymentId], references: [id])
  recordedBy     User?             @relation("StudentLedgerRecorder", fields: [recordedById], references: [id])
  studentCharge  StudentCharge?    @relation(fields: [studentChargeId], references: [id])
  reversesEntry  StudentLedgerEntry? @relation("StudentLedgerReversal", fields: [reversesEntryId], references: [id])
  reversedByEntries StudentLedgerEntry[] @relation("StudentLedgerReversal")

  @@index([schoolId, studentId, entryDate])
  @@index([studentId, entryDate])
  @@index([invoiceId])
  @@index([paymentId])
  @@map("student_ledger_entries")
}

model CommunicationBatch {
  id           String                    @id @default(cuid())
  schoolId     String
  category     CommunicationCategory
  channel      CommunicationChannel
  status       CommunicationBatchStatus  @default(PENDING)
  totalCount   Int                       @default(0)
  queuedCount  Int                       @default(0)
  sentCount    Int                       @default(0)
  failedCount  Int                       @default(0)
  filters      Json?
  createdById  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  completedAt  DateTime?

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  logs         CommunicationLog[]

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("communication_batches")
}

model CommunicationLog {
  id               String                @id @default(cuid())
  schoolId         String
  batchId          String?
  studentId        String?
  channel          CommunicationChannel
  category         CommunicationCategory @default(GENERAL)
  status           CommunicationStatus   @default(LOGGED)
  recipientName    String?
  recipientContact String
  subject          String?
  message          String
  error            String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch            CommunicationBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  student          Student?              @relation(fields: [studentId], references: [id])

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
  @@index([category, status])
  @@index([batchId, status])
  @@map("communication_logs")
}

// ─── Audit Trail (POPIA) ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?    @relation("AuditActor", fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Licensing ───────────────────────────────────────────────────────────────

enum LicenseStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum LicenseCheckResult {
  VALID
  GRACE
  EXPIRED
  SUSPENDED
  REVOKED
  INVALID_SIGNATURE
  SERVER_UNAVAILABLE
  OFFLINE_CACHE
  RESTRICTED
  ACTIVATED
  UPDATED
}

enum BackupType {
  CLOUD_SCHEDULED
  CLOUD_MANUAL
  OFFLINE
  PRE_RESTORE
}

enum BackupJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  VERIFYING
  VERIFIED
  DELETED
}

enum BackupScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RestoreJobStatus {
  UPLOADING
  VALIDATING
  READY
  RESTORING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportJobStatus {
  UPLOADED
  ANALYSING
  ANALYSED
  VALIDATING
  VALIDATED
  MAPPING
  MAPPED
  DETECTING_DUPLICATES
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportIssueSeverity {
  ERROR
  WARNING
  INFORMATION
}

enum DuplicateAction {
  SKIP
  UPDATE_EXISTING
  CREATE_NEW
  REVIEW_MANUALLY
}

/// Cached licence for one tenant. Signed payload is verified with LICENSE_PUBLIC_KEY.
model SchoolLicense {
  id                  String        @id @default(cuid())
  schoolId            String        @unique
  productCode         String        @default("lms")
  productName         String        @default("SchoolHub SA LMS")
  planCode            String?
  planName            String?
  licenseKey          String
  status              LicenseStatus @default(TRIAL)
  issuedAt            DateTime?
  startsAt            DateTime?
  expiresAt           DateTime?
  gracePeriodDays     Int           @default(14)
  maxLearners         Int?
  maxEducators        Int?
  maxAdministrators   Int?
  maxCampuses         Int?
  storageLimitBytes   BigInt?
  featuresJson        Json          @default("{}")
  signedPayload       String?
  lastVerifiedAt      DateTime?
  nextVerificationAt  DateTime?
  lastCheckError      String?
  offlineSince        DateTime?
  installationId      String?
  registeredDomain    String?
  stagingDomain       String?
  serverInstanceId    String?
  customerName        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  school              School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  features            LicenseFeature[]
  checks              LicenseCheck[]

  @@index([licenseKey])
  @@index([status])
  @@map("school_licenses")
}

model LicenseFeature {
  id        String   @id @default(cuid())
  licenseId String
  featureKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license   SchoolLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, featureKey])
  @@index([featureKey])
  @@map("license_features")
}

model LicenseCheck {
  id         String             @id @default(cuid())
  schoolId   String
  licenseId  String?
  result     LicenseCheckResult
  source     String
  message    String?
  checkedAt  DateTime           @default(now())
  metadata   Json?

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  license    SchoolLicense?     @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([schoolId, checkedAt])
  @@index([licenseId, checkedAt])
  @@map("license_checks")
}

model LicenseInstallation {
  id                String   @id @default(cuid())
  installationId    String   @unique
  schoolId          String?  @unique
  hostname          String?
  registeredDomain  String?
  stagingDomain     String?
  serverInstanceId  String?
  activatedAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("license_installations")
}

/// Vendor catalogue — used only when LICENSE_SERVER_ENABLED=true
model LicenseCustomer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licences  IssuedLicense[]

  @@map("license_customers")
}

model LicenseProduct {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans       LicensePlan[]
  licences    IssuedLicense[]

  @@map("license_products")
}

model LicensePlan {
  id               String   @id @default(cuid())
  productId        String
  code             String
  name             String
  defaultLimits    Json     @default("{}")
  defaultFeatures  Json     @default("{}")
  defaultGraceDays Int      @default(14)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          LicenseProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  licences         IssuedLicense[]

  @@unique([productId, code])
  @@map("license_plans")
}

model IssuedLicense {
  id              String        @id @default(cuid())
  customerId      String?
  productId       String
  planId          String?
  licenseKey      String        @unique
  institutionId   String?
  institutionName String?
  status          LicenseStatus @default(TRIAL)
  issuedAt        DateTime      @default(now())
  startsAt        DateTime      @default(now())
  expiresAt       DateTime?
  gracePeriodDays Int           @default(14)
  limitsJson      Json          @default("{}")
  featuresJson    Json          @default("{}")
  domainsJson     Json          @default("[]")
  maxActivations  Int           @default(1)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        LicenseCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product         LicenseProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  plan            LicensePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  activations     LicenseActivation[]

  @@index([institutionId])
  @@index([status])
  @@map("issued_licenses")
}

model LicenseActivation {
  id               String   @id @default(cuid())
  issuedLicenseId  String
  installationId   String
  domain           String?
  serverInstanceId String?
  isActive         Boolean  @default(true)
  activatedAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  revokedAt        DateTime?

  issuedLicense    IssuedLicense @relation(fields: [issuedLicenseId], references: [id], onDelete: Cascade)

  @@unique([issuedLicenseId, installationId])
  @@index([installationId])
  @@map("license_activations")
}

model LicenseServerAudit {
  id         String   @id @default(cuid())
  action     String
  licenseKey String?
  actor      String?
  result     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([licenseKey])
  @@map("license_server_audits")
}

// ─── Backup & Restore ────────────────────────────────────────────────────────

model BackupSchedule {
  id          String                   @id @default(cuid())
  schoolId    String
  frequency   BackupScheduleFrequency
  retainCount Int                      @default(14)
  enabled     Boolean                  @default(true)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  school      School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, frequency])
  @@index([enabled, nextRunAt])
  @@map("backup_schedules")
}

model BackupJob {
  id                  String           @id @default(cuid())
  schoolId            String
  type                BackupType
  status              BackupJobStatus  @default(PENDING)
  createdById         String?
  applicationVersion  String
  schemaVersion       String
  sizeBytes           BigInt           @default(0)
  checksum            String?
  storageProvider     String
  storageKey          String?
  filename            String?
  errorMessage        String?
  learnerCount        Int              @default(0)
  userCount           Int              @default(0)
  fileCount           Int              @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  verifiedAt          DateTime?
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy           User?            @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files               BackupFile[]
  restoreJobs         RestoreJob[]     @relation("RestoreSourceBackup")
  preRestoreFor       RestoreJob[]     @relation("PreRestoreBackup")

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("backup_jobs")
}

model BackupFile {
  id           String    @id @default(cuid())
  jobId        String
  relativePath String
  sizeBytes    BigInt    @default(0)
  checksum     String?
  mimeType     String?
  createdAt    DateTime  @default(now())

  job          BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("backup_files")
}

model RestoreJob {
  id                  String            @id @default(cuid())
  schoolId            String
  backupJobId         String?
  sourceType          String
  status              RestoreJobStatus  @default(UPLOADING)
  createdById         String?
  preRestoreBackupId  String?
  errorMessage        String?
  validationReport    Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  backupJob           BackupJob?        @relation("RestoreSourceBackup", fields: [backupJobId], references: [id], onDelete: SetNull)
  preRestoreBackup    BackupJob?        @relation("PreRestoreBackup", fields: [preRestoreBackupId], references: [id], onDelete: SetNull)
  createdBy           User?             @relation("RestoreCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("restore_jobs")
}

// ─── Integrations & SA-SAMS Import ───────────────────────────────────────────

model IntegrationProvider {
  id        String   @id @default(cuid())
  schoolId  String?
  code      String
  name      String
  type      String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([code])
  @@map("integration_providers")
}

model ImportJob {
  id                  String           @id @default(cuid())
  schoolId            String
  providerCode        String           @default("sa-sams")
  adapterId           String
  filename            String
  mimeType            String?
  fileSize            Int              @default(0)
  encryptedStorageKey String?
  status              ImportJobStatus  @default(UPLOADED)
  createdById         String?
  analysedAt          DateTime?
  importedAt          DateTime?
  rolledBackAt        DateTime?
  expiresAt           DateTime?
  summary             Json?
  mappingId           String?
  errorMessage        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy           User?            @relation("ImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mapping             ImportFieldMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  batches             ImportBatch[]
  stagingRecords      ImportStagingRecord[]
  errors              ImportError[]

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("import_jobs")
}

model ImportBatch {
  id            String          @id @default(cuid())
  jobId         String
  schoolId      String
  status        ImportJobStatus @default(IMPORTING)
  createdCount  Int             @default(0)
  updatedCount  Int             @default(0)
  skippedCount  Int             @default(0)
  errorCount    Int             @default(0)
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  job           ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  mappings      ExternalRecordMapping[]

  @@index([schoolId, createdAt])
  @@index([jobId])
  @@map("import_batches")
}

model ImportStagingRecord {
  id               String             @id @default(cuid())
  jobId            String
  entityType       String
  sourceRecordId   String?
  sourceRow        Int?
  rawData          Json
  mappedData       Json?
  validationStatus String             @default("PENDING")
  issues           Json?
  duplicateOfId    String?
  duplicateAction  DuplicateAction    @default(REVIEW_MANUALLY)
  importedEntityId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  job              ImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  errors           ImportError[]

  @@index([jobId, entityType])
  @@index([jobId, validationStatus])
  @@map("import_staging_records")
}

model ImportError {
  id               String              @id @default(cuid())
  jobId            String
  stagingRecordId  String?
  severity         ImportIssueSeverity
  code             String
  message          String
  field            String?
  createdAt        DateTime            @default(now())

  job              ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stagingRecord    ImportStagingRecord? @relation(fields: [stagingRecordId], references: [id], onDelete: SetNull)

  @@index([jobId, severity])
  @@map("import_errors")
}

model ImportFieldMapping {
  id             String   @id @default(cuid())
  schoolId       String
  providerCode   String   @default("sa-sams")
  adapterVersion String
  name           String
  mappings       Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jobs           ImportJob[]

  @@index([schoolId, providerCode])
  @@map("import_field_mappings")
}

model ExternalRecordMapping {
  id             String      @id @default(cuid())
  schoolId       String
  sourceSystem   String
  sourceRecordId String
  entityType     String
  localEntityId  String
  importBatchId  String?
  importedAt     DateTime    @default(now())
  importedById   String?

  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch          ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, sourceSystem, entityType, sourceRecordId])
  @@index([schoolId, localEntityId])
  @@index([importBatchId])
  @@map("external_record_mappings")
}

// ─── Finance: fee engine, expenses, accounts ─────────────────────────────────

model EnrolmentModule {
  id          String    @id @default(cuid())
  enrolmentId String
  moduleId    String
  createdAt   DateTime  @default(now())

  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, moduleId])
  @@index([moduleId])
  @@map("enrolment_modules")
}

model FeeStructure {
  id                 String           @id @default(cuid())
  schoolId           String
  name               String
  description        String?
  chargeSource       FeeChargeSource
  amount             Decimal          @db.Decimal(12, 2)
  billingFrequency   BillingFrequency @default(ONCE)
  allowInstalments   Boolean          @default(false)
  instalmentCount    Int?
  customScheduleJson Json?
  academicYearId     String?
  termId             String?
  campusId           String?
  gradeId            String?
  classId            String?
  courseId           String?
  moduleId           String?
  qualification      String?
  dueDayOfMonth      Int?
  applyOnEnrolment   Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear?    @relation(fields: [academicYearId], references: [id])
  term               Term?            @relation(fields: [termId], references: [id])
  campus             Campus?          @relation(fields: [campusId], references: [id])
  grade              Grade?           @relation(fields: [gradeId], references: [id])
  class              Class?           @relation(fields: [classId], references: [id])
  course             Course?          @relation(fields: [courseId], references: [id])
  module             Module?          @relation(fields: [moduleId], references: [id])
  charges            StudentCharge[]

  @@index([schoolId, isActive, chargeSource])
  @@index([schoolId, academicYearId])
  @@map("fee_structures")
}

model StudentCharge {
  id               String          @id @default(cuid())
  schoolId         String
  studentId        String
  enrolmentId      String?
  feeStructureId   String?
  academicYearId   String?
  invoiceId        String?
  source           FeeChargeSource
  description      String
  amount           Decimal         @db.Decimal(12, 2)
  idempotencyKey   String          @unique
  reversedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolment        Enrolment?      @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  feeStructure     FeeStructure?   @relation(fields: [feeStructureId], references: [id])
  academicYear     AcademicYear?   @relation(fields: [academicYearId], references: [id])
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  instalments      ChargeInstalment[]
  ledgerEntries    StudentLedgerEntry[]

  @@index([schoolId, studentId])
  @@index([studentId, academicYearId])
  @@map("student_charges")
}

model ChargeInstalment {
  id             String           @id @default(cuid())
  studentChargeId String
  sequence       Int
  dueDate        DateTime
  amount         Decimal          @db.Decimal(12, 2)
  amountPaid     Decimal          @default(0) @db.Decimal(12, 2)
  status         InstalmentStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  charge         StudentCharge    @relation(fields: [studentChargeId], references: [id], onDelete: Cascade)
  allocations    PaymentAllocation[]

  @@unique([studentChargeId, sequence])
  @@index([dueDate, status])
  @@map("charge_instalments")
}

model PaymentAllocation {
  id            String   @id @default(cuid())
  schoolId      String
  paymentId     String
  invoiceId     String?
  instalmentId  String?
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  instalment    ChargeInstalment? @relation(fields: [instalmentId], references: [id])

  @@index([paymentId])
  @@index([schoolId])
  @@map("payment_allocations")
}

model CreditNote {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  number          String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  invoiceId       String?
  ledgerEntryId   String?  @unique
  createdById     String?
  createdAt       DateTime @default(now())

  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, number])
  @@index([studentId])
  @@map("credit_notes")
}

model Refund {
  id              String        @id @default(cuid())
  schoolId        String
  studentId       String
  paymentId       String?
  amount          Decimal       @db.Decimal(12, 2)
  reason          String
  status          ApprovalStatus @default(PENDING)
  ledgerEntryId   String?       @unique
  createdById     String?
  createdAt       DateTime      @default(now())
  processedAt     DateTime?

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId])
  @@map("refunds")
}

model StudentAidAward {
  id              String         @id @default(cuid())
  schoolId        String
  studentId       String
  academicYearId  String?
  type            StudentAidType
  name            String
  amount          Decimal        @db.Decimal(12, 2)
  ledgerEntryId   String?        @unique
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
  @@map("student_aid_awards")
}

model Supplier {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  vatNumber   String?
  accountRef  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  ledgerEntries LedgerEntry[]
  recurring   RecurringExpense[]

  @@index([schoolId, name])
  @@map("suppliers")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  recurring   RecurringExpense[]

  @@unique([schoolId, name])
  @@map("expense_categories")
}

model IncomeCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  otherIncomes OtherIncome[]

  @@unique([schoolId, name])
  @@map("income_categories")
}

model FinancialAccount {
  id          String   @id @default(cuid())
  schoolId    String
  campusId    String?
  name        String
  type        String   @default("BANK")
  accountRef  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id])
  expenses    Expense[]
  otherIncomes OtherIncome[]
  ledgerEntries LedgerEntry[]
  recurring   RecurringExpense[]

  @@index([schoolId])
  @@map("financial_accounts")
}

model Expense {
  id                 String         @id @default(cuid())
  schoolId           String
  supplierId         String?
  categoryId         String?
  financialAccountId String?
  recurringExpenseId String?
  description        String
  invoiceRef         String?
  amount             Decimal        @db.Decimal(12, 2)
  vatAmount          Decimal        @default(0) @db.Decimal(12, 2)
  transactionDate    DateTime
  paymentDate        DateTime?
  attachmentUrl      String?
  approvalStatus     ApprovalStatus @default(DRAFT)
  createdById        String?
  postedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supplier           Supplier?      @relation(fields: [supplierId], references: [id])
  category           ExpenseCategory? @relation(fields: [categoryId], references: [id])
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  ledgerEntry        LedgerEntry?

  @@index([schoolId, transactionDate])
  @@index([schoolId, approvalStatus])
  @@map("expenses")
}

model RecurringExpense {
  id                 String            @id @default(cuid())
  schoolId           String
  supplierId         String?
  categoryId         String?
  financialAccountId String?
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  interval           RecurringInterval @default(MONTHLY)
  nextDueDate        DateTime
  requireConfirm     Boolean           @default(true)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  category           ExpenseCategory?  @relation(fields: [categoryId], references: [id])
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  generated          Expense[]

  @@index([schoolId, isActive, nextDueDate])
  @@map("recurring_expenses")
}

model OtherIncome {
  id                 String         @id @default(cuid())
  schoolId           String
  categoryId         String?
  financialAccountId String?
  description        String
  amount             Decimal        @db.Decimal(12, 2)
  vatAmount          Decimal        @default(0) @db.Decimal(12, 2)
  receivedAt         DateTime
  reference          String?
  approvalStatus     ApprovalStatus @default(POSTED)
  createdById        String?
  createdAt          DateTime       @default(now())

  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category           IncomeCategory? @relation(fields: [categoryId], references: [id])
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  ledgerEntry        LedgerEntry?

  @@index([schoolId, receivedAt])
  @@map("other_incomes")
}

// ─── HR & Payroll ────────────────────────────────────────────────────────────

model Employee {
  id                 String           @id @default(cuid())
  schoolId           String
  userId             String?          @unique
  teacherId          String?          @unique
  campusId           String?
  employeeNumber     String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  saIdNumber         String?
  dateOfBirth        DateTime?
  gender             Gender?
  address            String?
  category           EmployeeCategory @default(OTHER)
  department         String?
  position           String?
  employmentType     EmploymentType   @default(PERMANENT)
  startDate          DateTime?
  endDate            DateTime?
  status             StaffStatus      @default(ACTIVE)
  emergencyName      String?
  emergencyPhone     String?
  bankName           String?
  bankAccountName    String?
  bankAccountLast4   String?
  bankAccountEnc     String?
  branchCode         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])
  teacher            Teacher?         @relation(fields: [teacherId], references: [id])
  campus             Campus?          @relation(fields: [campusId], references: [id])
  contracts          EmploymentContract[]
  salaryStructures   SalaryStructure[]
  documents          EmployeeDocument[]
  leaveEntitlements  LeaveEntitlement[]
  leaveRequests      LeaveRequest[]
  attendance         StaffAttendanceRecord[]
  payrollItems       PayrollItem[]
  timesheets         Timesheet[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId, status])
  @@index([schoolId, campusId])
  @@map("employees")
}

model EmploymentContract {
  id           String    @id @default(cuid())
  employeeId   String
  title        String
  startDate    DateTime
  endDate      DateTime?
  notes        String?
  documentUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employment_contracts")
}

model SalaryStructure {
  id             String        @id @default(cuid())
  employeeId     String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  payType        SalaryPayType @default(MONTHLY)
  baseSalary     Decimal       @default(0) @db.Decimal(12, 2)
  hourlyRate     Decimal?      @db.Decimal(12, 2)
  allowancesJson Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("salary_structures")
}

model EmployeeDocument {
  id          String               @id @default(cuid())
  employeeId  String
  type        EmployeeDocumentType @default(OTHER)
  title       String
  fileUrl     String
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
  @@map("employee_documents")
}

model LeavePolicy {
  id                 String        @id @default(cuid())
  schoolId           String
  leaveType          LeaveType
  name               String
  daysPerYear        Decimal       @db.Decimal(6, 2)
  accrualMethod      AccrualMethod @default(NONE)
  requiresHrApproval Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school             School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entitlements       LeaveEntitlement[]
  requests           LeaveRequest[]

  @@unique([schoolId, leaveType, name])
  @@index([schoolId, isActive])
  @@map("leave_policies")
}

model LeaveEntitlement {
  id              String      @id @default(cuid())
  employeeId      String
  leavePolicyId   String
  cycleYear       Int
  openingBalance  Decimal     @default(0) @db.Decimal(6, 2)
  accrued         Decimal     @default(0) @db.Decimal(6, 2)
  taken           Decimal     @default(0) @db.Decimal(6, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy     LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leavePolicyId, cycleYear])
  @@map("leave_entitlements")
}

model Timesheet {
  id          String   @id @default(cuid())
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  status      ApprovalStatus @default(DRAFT)
  totalHours  Decimal  @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal @default(0) @db.Decimal(8, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries     TimesheetEntry[]

  @@index([employeeId, periodStart])
  @@map("timesheets")
}

model TimesheetEntry {
  id           String    @id @default(cuid())
  timesheetId  String
  workDate     DateTime  @db.Date
  hours        Decimal   @db.Decimal(6, 2)
  overtimeHours Decimal  @default(0) @db.Decimal(6, 2)
  notes        String?

  timesheet    Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, workDate])
  @@map("timesheet_entries")
}

model PayrollRuleSet {
  id            String   @id @default(cuid())
  schoolId      String
  jurisdiction  String   @default("ZA")
  name          String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// Configurable statutory rates. Never hard-code tax tables in application logic.
  rulesJson     Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  runs          PayrollRun[]

  @@index([schoolId, jurisdiction, effectiveFrom])
  @@map("payroll_rule_sets")
}

model PayrollRun {
  id              String           @id @default(cuid())
  schoolId        String
  academicYearId  String?
  ruleSetId       String?
  periodStart     DateTime
  periodEnd       DateTime
  paymentDate     DateTime?
  status          PayrollRunStatus @default(DRAFT)
  notes           String?
  totalGross      Decimal          @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(12, 2)
  totalEmployer   Decimal          @default(0) @db.Decimal(12, 2)
  totalNet        Decimal          @default(0) @db.Decimal(12, 2)
  postedAt        DateTime?
  approvedAt      DateTime?
  approvedById    String?
  finalisedAt     DateTime?
  finalisedById   String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear?    @relation(fields: [academicYearId], references: [id])
  ruleSet         PayrollRuleSet?  @relation(fields: [ruleSetId], references: [id])
  items           PayrollItem[]
  ledgerEntries   LedgerEntry[]

  @@index([schoolId, periodStart])
  @@index([schoolId, status])
  @@map("payroll_runs")
}

model PayrollItem {
  id                    String      @id @default(cuid())
  payrollRunId          String
  employeeId            String
  grossPay              Decimal     @db.Decimal(12, 2)
  totalDeductions       Decimal     @db.Decimal(12, 2)
  employerContributions Decimal     @db.Decimal(12, 2)
  netPay                Decimal     @db.Decimal(12, 2)
  earningsJson          Json
  deductionsJson        Json
  employerJson          Json
  exceptionNote         String?
  createdAt             DateTime    @default(now())

  run                   PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee              Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslip               Payslip?

  @@unique([payrollRunId, employeeId])
  @@map("payroll_items")
}

model Payslip {
  id             String      @id @default(cuid())
  payrollItemId  String      @unique
  number         String
  generatedAt    DateTime    @default(now())

  item           PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

// ─── Learner portal services ─────────────────────────────────────────────────

model StudentAbsenceRequest {
  id           String             @id @default(cuid())
  schoolId     String
  studentId    String
  type         StudentAbsenceType
  fromDate     DateTime           @db.Date
  toDate       DateTime           @db.Date
  reason       String
  documentUrl  String?
  status       LeaveStatus        @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("StudentAbsenceReviewer", fields: [reviewedById], references: [id])

  @@index([schoolId, status])
  @@index([studentId, createdAt])
  @@map("student_absence_requests")
}

model TeacherReview {
  id                 String   @id @default(cuid())
  schoolId           String
  studentId          String
  teacherId          String
  periodKey          String
  teachingQuality    Int
  communication      Int
  preparedness       Int
  subjectKnowledge   Int
  availability       Int
  overall            Int
  comment            String?
  isAnonymous        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId, periodKey])
  @@index([schoolId, teacherId])
  @@map("teacher_reviews")
}

model LessonPlan {
  id                 String    @id @default(cuid())
  schoolId           String
  subjectId          String
  teacherId          String
  classId            String?
  termId             String?
  weekNumber         Int?
  title              String
  topic              String
  objective          String?
  resources          String?
  readingMaterial    String?
  relatedAssessmentId String?
  lessonDate         DateTime  @db.Date
  isPublished        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject            Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher            Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class              Class?    @relation(fields: [classId], references: [id])
  term               Term?     @relation(fields: [termId], references: [id])

  @@index([schoolId, subjectId])
  @@index([classId, lessonDate])
  @@map("lesson_plans")
}

model CurriculumTopic {
  id          String                 @id @default(cuid())
  schoolId    String
  subjectId   String
  classId     String?
  termId      String?
  title       String
  description String?
  sortOrder   Int                    @default(0)
  status      CurriculumTopicStatus  @default(PLANNED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class?                 @relation(fields: [classId], references: [id])
  term        Term?                  @relation(fields: [termId], references: [id])

  @@index([schoolId, subjectId])
  @@index([classId, sortOrder])
  @@map("curriculum_topics")
}

model VisitorEntry {
  id                  String               @id @default(cuid())
  schoolId            String
  campusId            String?
  firstName           String
  lastName            String
  organisation        String?
  phone               String?
  identityType        VisitorIdentityType?
  identityNumber      String?
  hostKind            VisitorHostKind
  hostName            String
  purpose             VisitorPurpose
  purposeDetail       String?
  vehicleRegistration String?
  badgeNumber         String?
  notes               String?
  signedInAt          DateTime             @default(now())
  signedOutAt         DateTime?
  signedInById        String
  signedOutById       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus              Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  signedInBy          User                 @relation("VisitorSignedInBy", fields: [signedInById], references: [id])
  signedOutBy         User?                @relation("VisitorSignedOutBy", fields: [signedOutById], references: [id], onDelete: SetNull)

  @@index([schoolId, signedOutAt])
  @@index([schoolId, signedInAt])
  @@map("visitor_entries")
}

