// SchoolHub SA - Multi-tenant School Management System
// Cyber Developers - South African schools, colleges & TVETs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  FINANCE_OFFICER
  ADMISSIONS_OFFICER
  HR_OFFICER
  STAFF
}

enum InstitutionType {
  SCHOOL
  PRIMARY_SCHOOL
  HIGH_SCHOOL
  COMBINED_SCHOOL
  COLLEGE
  TVET
  TRAINING_CENTRE
  TRAINING_INSTITUTION
}

enum CurriculumType {
  CAPS
  NSC
  TVET_NQF
  CUSTOM
}

enum AcademicPeriodStructure {
  TERMS_4
  SEMESTERS_2
  CUSTOM
}

enum AcademicSessionStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum StudentStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  REMOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  EFT
  BANK_DEPOSIT
  CARD
  PAYFAST
  OZOW
  YOCO
  MOBILE
  SCHOLARSHIP
  OTHER
}

enum AssessmentType {
  ASSIGNMENT
  TEST
  EXAM
  PROJECT
  PRACTICAL
  ORAL
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum DocumentType {
  ID_DOCUMENT
  REPORT_CARD
  CERTIFICATE
  ASSIGNMENT
  LEARNING_MATERIAL
  INVOICE
  RECEIPT
  TRANSCRIPT
  OTHER
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  PARENTS
  STAFF
  TEACHERS
  FINANCE
}

enum CertificateType {
  COMPLETION
  GRADUATION
  MERIT
  ATTENDANCE
}

enum LeaveType {
  ANNUAL
  SICK
  FAMILY
  MATERNITY
  STUDY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StudentAbsenceType {
  SICK
  FAMILY
  PERSONAL
  SCHOOL_ACTIVITY
  OTHER
}

enum CurriculumTopicStatus {
  PLANNED
  CURRENT
  COMPLETED
}

enum LedgerEntryType {
  INCOME
  EXPENSE
}

enum EnrolmentStatus {
  ENROLLED
  COMPLETED
  WITHDRAWN
  DEFERRED
  PROMOTED
  REPEATED
  GRADUATED
  TRANSFERRED
}

enum DayOfWeek {
