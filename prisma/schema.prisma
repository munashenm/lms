  SUCCESS
  WARNING
  FEE
  ACADEMIC
  ATTENDANCE
  ADMISSION
}

enum CommunicationChannel {
  EMAIL
  SMS
  IN_APP
}

enum CommunicationCategory {
  ABSENCE_ALERT
  FEE_REMINDER
  FEE_STATEMENT
  ACADEMIC_NOTICE
  EXAM_NOTICE
  ANNOUNCEMENT
  EMERGENCY
  GENERAL
}

enum CommunicationStatus {
